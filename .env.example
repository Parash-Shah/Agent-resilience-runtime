# Use deterministic for an offline demo or live for the Agents SDK path.
AGENT_MODE=deterministic
OPENAI_API_KEY=replace-with-a-project-scoped-key
OPENAI_MODEL=gpt-5.6-terra
ADMIN_API_TOKEN=replace-with-a-long-random-token
VIEWER_API_TOKEN=replace-with-a-separate-read-only-token
DATABASE_PATH=data/agent-resilience.db
RUNTIME_BACKEND=sqlite
TOOL_BACKEND=scenario
RUN_WORKER=false
# AWS mode (normally injected by the ECS task definition):
# AWS_REGION=us-east-1
# DYNAMODB_TABLE_NAME=agent-resilience-dev-workflows
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/agent-resilience-dev-tasks
# SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/agent-resilience-dev-dlq
# ECS_CLUSTER=production-cluster
# CLOUDWATCH_LOG_GROUP_PREFIX=/ecs
# CLOUDWATCH_METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318/v1/traces
# CHAOS_PAUSE_TOOL=dependency_health
# CHAOS_PAUSE_AFTER_STEPS=3
# CHAOS_PAUSE_SECONDS=30
